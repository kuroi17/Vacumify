<Window x:Class="Vacumify.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Vacumify" Height="740" Width="1120" MinHeight="600" MinWidth="900"
        FontFamily="Segoe UI Variable Text, Segoe UI" Foreground="#0F172A">
  <Window.Background>
    <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
      <GradientStop Color="#EFF5FF" Offset="0" />
      <GradientStop Color="#F8FAFC" Offset="0.45" />
      <GradientStop Color="#FFFFFF" Offset="1" />
    </LinearGradientBrush>
  </Window.Background>

  <Grid Margin="24,20,24,20">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="*"/>
      <RowDefinition Height="Auto"/>
    </Grid.RowDefinitions>

    <!-- 1. Minimal Single-Line Header -->
    <Grid Grid.Row="0" Margin="0,0,0,16">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="*"/>
        <ColumnDefinition Width="Auto"/>
      </Grid.ColumnDefinitions>
      <TextBlock Grid.Column="0" Text="Vacumify" FontSize="23" FontWeight="Bold" Foreground="#0F172A" VerticalAlignment="Center" />
      <Border Grid.Column="1" Background="#ECFDF5" BorderBrush="#A7F3D0" BorderThickness="1" CornerRadius="12" Padding="10,4" VerticalAlignment="Center">
        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
          <Ellipse Width="6" Height="6" Fill="#10B981" Margin="0,0,6,0" VerticalAlignment="Center" />
          <TextBlock Text="Local only" FontSize="11.5" FontWeight="SemiBold" Foreground="#047857" />
        </StackPanel>
      </Border>
    </Grid>

    <!-- 2. Scan Input Card -->
    <Border Grid.Row="1" Background="#F2FFFFFF" BorderBrush="#D6E4FA" BorderThickness="1" CornerRadius="10" Padding="16" Margin="0,0,0,14">
      <StackPanel>
        <Grid>
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition Width="Auto"/>
          </Grid.ColumnDefinitions>
          <StackPanel Grid.Column="0">
            <TextBlock Text="Locations to scan" FontSize="12" FontWeight="SemiBold" Foreground="#475569" Margin="0,0,0,6" />
            <TextBox x:Name="RootsBox" AcceptsReturn="True" Height="42" Padding="10,7" VerticalScrollBarVisibility="Auto"
                     BorderBrush="#CBD5E1" BorderThickness="1" Background="White" FontSize="13" Foreground="#0F172A" />
          </StackPanel>
          <Button Grid.Column="1" Content="Add folder" Click="Browse_Click" Style="{StaticResource SecondaryButton}" VerticalAlignment="Bottom" Margin="10,0,8,0" Height="36"/>
          <Button x:Name="ScanButton" Grid.Column="2" Content="Scan" Click="Scan_Click" VerticalAlignment="Bottom" Height="36" MinWidth="92"/>
          <Button x:Name="CancelButton" Grid.Column="2" Content="Cancel" Click="Cancel_Click" Style="{StaticResource SecondaryButton}" VerticalAlignment="Bottom" Height="36" MinWidth="92" Visibility="Collapsed"/>
        </Grid>

        <!-- Compact Scan Options -->
        <WrapPanel Orientation="Horizontal" Margin="0,10,0,0" VerticalAlignment="Center">
          <CheckBox x:Name="IncludeCachesCheck" Content="Include hidden caches (.*)" Foreground="#334155" FontSize="12.5" VerticalAlignment="Center" Margin="0,0,20,0"
                    ToolTip="Scans hidden dot-folders like .cache, .android, .docker, .gradle, and .venv. OS folders, AppData, .git, and node_modules stay protected." />
          <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,20,0">
            <TextBlock Text="Dup min:" Foreground="#475569" FontSize="12.5" VerticalAlignment="Center" Margin="0,0,6,0"/>
            <ComboBox x:Name="MinDupSizeCombo" Width="125" SelectedIndex="0" Padding="6,3" FontSize="12"
                      ToolTip="Minimum file size checked for duplicates. Forgotten and Large tabs still scan all sizes.">
              <ComboBoxItem Content="100 KB+ (Fast)" Tag="102400"/>
              <ComboBoxItem Content="10 KB+" Tag="10240"/>
              <ComboBoxItem Content="1 MB+" Tag="1048576"/>
              <ComboBoxItem Content="All (&gt; 0 B)" Tag="1"/>
            </ComboBox>
          </StackPanel>
          <CheckBox x:Name="FastSampleCheck" Content="Fast hash (&gt; 16 MB)" IsChecked="True" Foreground="#334155" FontSize="12.5" VerticalAlignment="Center"
                    ToolTip="Verifies files over 16 MB using 8 distributed 64 KB blocks for sub-10s scans. Uncheck for full-file SHA-256 on huge files." />
        </WrapPanel>

        <!-- Live Progress (Visible only while scanning) -->
        <StackPanel x:Name="ProgressPanel" Visibility="Collapsed" Margin="0,12,0,0">
          <ProgressBar x:Name="ScanProgress" Height="4" IsIndeterminate="True" Foreground="#2563EB" Background="#E2ECFA" BorderThickness="0" Margin="0,0,0,6"/>
          <TextBlock x:Name="StatusText" Text="Scanning…" FontSize="12" Foreground="#475569" TextTrimming="CharacterEllipsis" />
        </StackPanel>
      </StackPanel>
    </Border>

    <!-- 3. Segmented Pill Tabs + Right Controls -->
    <Grid Grid.Row="2">
      <TabControl x:Name="ResultsTabs" Style="{StaticResource PillTabControl}" SelectionChanged="ResultsTabs_SelectionChanged">
        <!-- Overview Tab -->
        <TabItem Header="Overview">
          <Grid Margin="22">
            <Grid.RowDefinitions>
              <RowDefinition Height="Auto"/>
              <RowDefinition Height="Auto"/>
              <RowDefinition Height="*"/>
              <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Primary KPI Cards -->
            <UniformGrid Grid.Row="0" Columns="3" Margin="0,0,0,12">
              <Border Background="#FAFCFF" BorderBrush="#DCE8FA" BorderThickness="1" CornerRadius="10" Padding="18,16" Margin="0,0,10,0">
                <StackPanel>
                  <TextBlock Text="Files scanned" Foreground="#64748B" FontSize="12.5" FontWeight="Medium"/>
                  <TextBlock x:Name="FilesCount" Text="—" FontSize="26" FontWeight="Bold" Foreground="#0F172A" Typography.NumeralAlignment="Tabular" Margin="0,6,0,0"/>
                </StackPanel>
              </Border>
              <Border Background="#FAFCFF" BorderBrush="#DCE8FA" BorderThickness="1" CornerRadius="10" Padding="18,16" Margin="0,0,10,0">
                <StackPanel>
                  <TextBlock Text="Total storage" Foreground="#64748B" FontSize="12.5" FontWeight="Medium"/>
                  <TextBlock x:Name="TotalScannedSize" Text="—" FontSize="26" FontWeight="Bold" Foreground="#0F172A" Typography.NumeralAlignment="Tabular" Margin="0,6,0,0"/>
                </StackPanel>
              </Border>
              <Border Background="#EFF6FF" BorderBrush="#BFDBFE" BorderThickness="1" CornerRadius="10" Padding="18,16">
                <StackPanel>
                  <TextBlock Text="Reclaimable duplicates" Foreground="#1D4ED8" FontSize="12.5" FontWeight="SemiBold"/>
                  <TextBlock x:Name="ReclaimableSpaceText" Text="—" FontSize="26" FontWeight="Bold" Foreground="#2563EB" Typography.NumeralAlignment="Tabular" Margin="0,6,0,0"/>
                </StackPanel>
              </Border>
            </UniformGrid>

            <!-- Clickable Category Jump Cards -->
            <UniformGrid Grid.Row="1" Columns="3">
              <Button Style="{StaticResource ActionCardButton}" Click="JumpForgotten_Click" Margin="0,0,10,0">
                <StackPanel>
                  <TextBlock Text="Forgotten files" Foreground="#64748B" FontSize="12.5" FontWeight="Medium"/>
                  <TextBlock x:Name="ForgottenCount" Text="—" FontSize="24" FontWeight="Bold" Foreground="#0F172A" Typography.NumeralAlignment="Tabular" Margin="0,6,0,6"/>
                  <TextBlock Text="Not accessed 30d+ · Review →" Foreground="#2563EB" FontSize="12" FontWeight="SemiBold"/>
                </StackPanel>
              </Button>
              <Button Style="{StaticResource ActionCardButton}" Click="JumpDuplicates_Click" Margin="0,0,10,0">
                <StackPanel>
                  <TextBlock Text="Duplicate copies" Foreground="#64748B" FontSize="12.5" FontWeight="Medium"/>
                  <TextBlock x:Name="DuplicateCount" Text="—" FontSize="24" FontWeight="Bold" Foreground="#0F172A" Typography.NumeralAlignment="Tabular" Margin="0,6,0,6"/>
                  <TextBlock Text="Identical content · Review →" Foreground="#2563EB" FontSize="12" FontWeight="SemiBold"/>
                </StackPanel>
              </Button>
              <Button Style="{StaticResource ActionCardButton}" Click="JumpLarge_Click">
                <StackPanel>
                  <TextBlock Text="Large files" Foreground="#64748B" FontSize="12.5" FontWeight="Medium"/>
                  <TextBlock x:Name="LargeCount" Text="—" FontSize="24" FontWeight="Bold" Foreground="#0F172A" Typography.NumeralAlignment="Tabular" Margin="0,6,0,6"/>
                  <TextBlock Text="100 MB+ · Review →" Foreground="#2563EB" FontSize="12" FontWeight="SemiBold"/>
                </StackPanel>
              </Button>
            </UniformGrid>

            <!-- Single-Line Subtle Footer -->
            <TextBlock Grid.Row="3" Text="Nothing is deleted automatically — reviewed files move to the Windows Recycle Bin."
                       Foreground="#94A3B8" FontSize="12" HorizontalAlignment="Center" Margin="0,12,0,0" />
          </Grid>
        </TabItem>

        <!-- Forgotten Files Tab -->
        <TabItem x:Name="ForgottenTab" Header="Forgotten">
          <Grid>
            <Grid.RowDefinitions>
              <RowDefinition Height="Auto"/>
              <RowDefinition Height="*"/>
            </Grid.RowDefinitions>
            <Border Grid.Row="0" Background="#F8FAFF" BorderBrush="#E8EFFA" BorderThickness="0,0,0,1" Padding="14,9" CornerRadius="10,10,0,0">
              <Grid>
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="*"/>
                  <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                  <TextBlock Text="Not accessed for" Foreground="#475569" FontSize="12.5" VerticalAlignment="Center" Margin="0,0,8,0"/>
                  <ComboBox x:Name="AgeFilter" Width="115" SelectedIndex="2" SelectionChanged="Filters_SelectionChanged">
                    <ComboBoxItem Content="7 days" Tag="7"/>
                    <ComboBoxItem Content="15 days" Tag="15"/>
                    <ComboBoxItem Content="30 days" Tag="30"/>
                    <ComboBoxItem Content="60 days" Tag="60"/>
                    <ComboBoxItem Content="90 days" Tag="90"/>
                  </ComboBox>
                </StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal">
                  <Button Content="Select all" Click="ForgottenSelectAll_Click" Style="{StaticResource SecondaryButton}" Margin="0,0,6,0" />
                  <Button Content="Deselect all" Click="ForgottenDeselectAll_Click" Style="{StaticResource SecondaryButton}" />
                </StackPanel>
              </Grid>
            </Border>

            <DataGrid x:Name="ForgottenGrid" Grid.Row="1" Margin="6" AutoGenerateColumns="False" CanUserAddRows="False" IsReadOnly="False"
                      SelectionMode="Extended" HeadersVisibility="Column" GridLinesVisibility="Horizontal"
                      VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling"
                      EnableRowVirtualization="True" ScrollViewer.CanContentScroll="True">
              <DataGrid.Columns>
                <DataGridCheckBoxColumn Header="Delete" Binding="{Binding Selected, UpdateSourceTrigger=PropertyChanged}" Width="60"/>
                <DataGridTextColumn Header="Name" Binding="{Binding Name}" Width="210" IsReadOnly="True"/>
                <DataGridTextColumn Header="Size" Binding="{Binding SizeText}" Width="90" IsReadOnly="True"/>
                <DataGridTextColumn Header="Last accessed" Binding="{Binding AccessedText}" Width="135" IsReadOnly="True"/>
                <DataGridTextColumn Header="Last modified" Binding="{Binding ModifiedText}" Width="135" IsReadOnly="True"/>
                <DataGridTextColumn Header="Path" Binding="{Binding Path}" Width="*" IsReadOnly="True"/>
              </DataGrid.Columns>
            </DataGrid>
          </Grid>
        </TabItem>

        <!-- Duplicate Files Tab -->
        <TabItem x:Name="DuplicatesTab" Header="Duplicates">
          <Grid>
            <Grid.RowDefinitions>
              <RowDefinition Height="Auto"/>
              <RowDefinition Height="*"/>
            </Grid.RowDefinitions>
            <Border Grid.Row="0" Background="#F8FAFF" BorderBrush="#E8EFFA" BorderThickness="0,0,0,1" Padding="14,9" CornerRadius="10,10,0,0">
              <Grid>
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="*"/>
                  <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                  <Button Content="Keep newest" Click="KeepNewest_Click" Style="{StaticResource SecondaryButton}" Margin="0,0,6,0" />
                  <Button Content="Keep oldest" Click="KeepOldest_Click" Style="{StaticResource SecondaryButton}" />
                </StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal">
                  <Button Content="Select all" Click="DuplicatesSelectAll_Click" Style="{StaticResource SecondaryButton}" Margin="0,0,6,0" />
                  <Button Content="Deselect all" Click="DuplicatesDeselectAll_Click" Style="{StaticResource SecondaryButton}" />
                </StackPanel>
              </Grid>
            </Border>

            <DataGrid x:Name="DuplicatesGrid" Grid.Row="1" Margin="6" AutoGenerateColumns="False" CanUserAddRows="False" IsReadOnly="False"
                      SelectionMode="Extended" HeadersVisibility="Column" GridLinesVisibility="Horizontal"
                      VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling"
                      EnableRowVirtualization="True" ScrollViewer.CanContentScroll="True">
              <DataGrid.Columns>
                <DataGridCheckBoxColumn Header="Delete" Binding="{Binding Selected, UpdateSourceTrigger=PropertyChanged}" Width="60"/>
                <DataGridTextColumn Header="Group" Binding="{Binding DuplicateGroupId}" Width="65" IsReadOnly="True"/>
                <DataGridTextColumn Header="Name" Binding="{Binding Name}" Width="210" IsReadOnly="True"/>
                <DataGridTextColumn Header="Size" Binding="{Binding SizeText}" Width="90" IsReadOnly="True"/>
                <DataGridTextColumn Header="Copies" Binding="{Binding DuplicateGroupCount}" Width="65" IsReadOnly="True"/>
                <DataGridTextColumn Header="Last modified" Binding="{Binding ModifiedText}" Width="135" IsReadOnly="True"/>
                <DataGridTextColumn Header="Path" Binding="{Binding Path}" Width="*" IsReadOnly="True"/>
              </DataGrid.Columns>
            </DataGrid>
          </Grid>
        </TabItem>

        <!-- Large Files Tab -->
        <TabItem x:Name="LargeTab" Header="Large">
          <Grid>
            <Grid.RowDefinitions>
              <RowDefinition Height="Auto"/>
              <RowDefinition Height="*"/>
            </Grid.RowDefinitions>
            <Border Grid.Row="0" Background="#F8FAFF" BorderBrush="#E8EFFA" BorderThickness="0,0,0,1" Padding="14,9" CornerRadius="10,10,0,0">
              <Grid>
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="*"/>
                  <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                  <TextBlock Text="At least" Foreground="#475569" FontSize="12.5" VerticalAlignment="Center" Margin="0,0,8,0"/>
                  <ComboBox x:Name="SizeFilter" Width="115" SelectedIndex="0" SelectionChanged="Filters_SelectionChanged">
                    <ComboBoxItem Content="100 MB" Tag="104857600"/>
                    <ComboBoxItem Content="500 MB" Tag="524288000"/>
                    <ComboBoxItem Content="1 GB" Tag="1073741824"/>
                    <ComboBoxItem Content="5 GB" Tag="5368709120"/>
                  </ComboBox>
                </StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal">
                  <Button Content="Select all" Click="LargeSelectAll_Click" Style="{StaticResource SecondaryButton}" Margin="0,0,6,0" />
                  <Button Content="Deselect all" Click="LargeDeselectAll_Click" Style="{StaticResource SecondaryButton}" />
                </StackPanel>
              </Grid>
            </Border>

            <DataGrid x:Name="LargeGrid" Grid.Row="1" Margin="6" AutoGenerateColumns="False" CanUserAddRows="False" IsReadOnly="False"
                      SelectionMode="Extended" HeadersVisibility="Column" GridLinesVisibility="Horizontal"
                      VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling"
                      EnableRowVirtualization="True" ScrollViewer.CanContentScroll="True">
              <DataGrid.Columns>
                <DataGridCheckBoxColumn Header="Delete" Binding="{Binding Selected, UpdateSourceTrigger=PropertyChanged}" Width="60"/>
                <DataGridTextColumn Header="Name" Binding="{Binding Name}" Width="210" IsReadOnly="True"/>
                <DataGridTextColumn Header="Size" Binding="{Binding SizeText}" Width="90" IsReadOnly="True"/>
                <DataGridTextColumn Header="Last modified" Binding="{Binding ModifiedText}" Width="135" IsReadOnly="True"/>
                <DataGridTextColumn Header="Path" Binding="{Binding Path}" Width="*" IsReadOnly="True"/>
              </DataGrid.Columns>
            </DataGrid>
          </Grid>
        </TabItem>
      </TabControl>

      <!-- Top-Right Strip Controls (Scan Timing Pill + File Type Filter) -->
      <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,3,0,0">
        <Border x:Name="ScanBadge" Background="#EFF6FF" BorderBrush="#CFE0FA" BorderThickness="1" CornerRadius="6" Padding="9,5" Margin="0,0,10,0" Visibility="Collapsed">
          <TextBlock x:Name="ScanBadgeText" Text="" FontSize="12" FontWeight="SemiBold" Foreground="#1D4ED8" />
        </Border>
        <StackPanel x:Name="ExtFilterPanel" Orientation="Horizontal" VerticalAlignment="Center" Visibility="Collapsed">
          <TextBlock Text="Filter:" Foreground="#64748B" FontSize="12.5" VerticalAlignment="Center" Margin="0,0,6,0"/>
          <TextBox x:Name="ExtensionFilter" Text="*" Width="115" Padding="7,5" BorderBrush="#CBD5E1" Background="White" FontSize="12.5"
                   TextChanged="ExtensionFilter_TextChanged" ToolTip="Comma-separated extensions (e.g. .mp4,.zip) or * for all" />
        </StackPanel>
      </StackPanel>
    </Grid>

    <!-- 4. Context-Aware Footer Action Bar (Only visible on file list tabs) -->
    <Grid x:Name="ActionBar" Grid.Row="3" Margin="0,12,0,0" Visibility="Collapsed">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="*"/>
        <ColumnDefinition Width="Auto"/>
      </Grid.ColumnDefinitions>

      <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
        <Border Background="#EFF6FF" BorderBrush="#CFE0FA" BorderThickness="1" CornerRadius="6" Padding="10,6" Margin="0,0,10,0">
          <TextBlock x:Name="SelectedSummaryText" Text="0 files selected" FontSize="12.5" FontWeight="SemiBold" Foreground="#1E293B"/>
        </Border>
        <TextBlock x:Name="ErrorSummary" Text="" FontSize="12" Foreground="#B45309" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
      </StackPanel>

      <StackPanel Grid.Column="1" Orientation="Horizontal">
        <Button Content="Open in Explorer" Click="OpenLocation_Click" Style="{StaticResource SecondaryButton}" Height="36" Margin="0,0,8,0"/>
        <Button x:Name="DeleteButton" Content="Move to Recycle Bin" Click="Delete_Click" Style="{StaticResource DangerButton}" Height="36"/>
      </StackPanel>
    </Grid>
  </Grid>
</Window>
