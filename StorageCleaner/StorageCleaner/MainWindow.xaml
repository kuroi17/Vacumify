<Window x:Class="Vacumify.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Vacumify" Icon="Assets/vacumify.ico"
        Height="770" Width="1240" MinHeight="650" MinWidth="980"
        FontFamily="{StaticResource BodyFont}" Foreground="{StaticResource TextPrimary}">
  <Window.Resources>
    <Style x:Key="FileNameCellText" TargetType="TextBlock">
      <Setter Property="FontFamily" Value="{StaticResource BodyFont}" />
      <Setter Property="FontSize" Value="12.5" />
      <Setter Property="FontWeight" Value="Normal" />
      <Setter Property="Foreground" Value="#0F172A" />
      <Setter Property="VerticalAlignment" Value="Center" />
      <Setter Property="TextTrimming" Value="CharacterEllipsis" />
    </Style>

    <Style x:Key="MonoCellText" TargetType="TextBlock">
      <Setter Property="FontFamily" Value="{StaticResource MonoFont}" />
      <Setter Property="FontSize" Value="12" />
      <Setter Property="FontWeight" Value="Normal" />
      <Setter Property="Foreground" Value="#475569" />
      <Setter Property="VerticalAlignment" Value="Center" />
      <Setter Property="TextTrimming" Value="CharacterEllipsis" />
    </Style>
  </Window.Resources>

  <Grid>
    <Grid.ColumnDefinitions>
      <ColumnDefinition Width="220"/>
      <ColumnDefinition Width="*"/>
      <ColumnDefinition x:Name="InspectorCol" Width="Auto"/>
    </Grid.ColumnDefinitions>

    <!-- =================================================================== -->
    <!-- 1. LEFT SIDEBAR (Single Brand Anchor + Quick Targets + Options)     -->
    <!-- =================================================================== -->
    <Border Grid.Column="0" Background="{StaticResource SkyTintSurface}" BorderBrush="{StaticResource SkyHairline}" BorderThickness="0,0,1,0">
      <Grid Margin="16,18,16,16">
        <Grid.RowDefinitions>
          <RowDefinition Height="Auto"/>
          <RowDefinition Height="*"/>
          <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Clean Single Brand Lockup (No redundant pill) -->
        <StackPanel Grid.Row="0" Orientation="Horizontal" VerticalAlignment="Center" Margin="4,0,0,24">
          <Border Width="36" Height="36" CornerRadius="9" BorderBrush="#CBE3FA" BorderThickness="1"
                  RenderOptions.BitmapScalingMode="HighQuality" Margin="0,0,11,0">
            <Border.Background>
              <ImageBrush ImageSource="Assets/vacumify-logo.png" Stretch="UniformToFill" />
            </Border.Background>
          </Border>
          <TextBlock Text="Vacumify" FontFamily="{StaticResource DisplayFont}" FontSize="20" FontWeight="Bold"
                     Foreground="#0F172A" VerticalAlignment="Center" />
        </StackPanel>

        <!-- Quick Targets -->
        <StackPanel Grid.Row="1">
          <TextBlock Text="QUICK TARGETS" FontSize="10.5" FontWeight="SemiBold" Foreground="#64748B" Margin="10,0,0,8" />

          <Button x:Name="QuickUserHomeBtn" Tag="UserHome" Click="QuickTarget_Click" Style="{StaticResource SidebarTargetButton}">
            <StackPanel Orientation="Horizontal">
              <Path Data="M3,9 L12,2 L21,9 V20 A1,1 0 0 1 20,21 H4 A1,1 0 0 1 3,20 Z" Stroke="#0284C7" StrokeThickness="1.6" Width="15" Height="15" Stretch="Uniform" Margin="0,0,9,0"/>
              <TextBlock Text="User Home" />
            </StackPanel>
          </Button>
          <Button x:Name="QuickDownloadsBtn" Tag="Downloads" Click="QuickTarget_Click" Style="{StaticResource SidebarTargetButton}">
            <StackPanel Orientation="Horizontal">
              <Path Data="M12,3 V15 M7,10 L12,15 L17,10 M4,19 H20" Stroke="#0284C7" StrokeThickness="1.6" Width="15" Height="15" Stretch="Uniform" Margin="0,0,9,0"/>
              <TextBlock Text="Downloads" />
            </StackPanel>
          </Button>
          <Button x:Name="QuickDesktopBtn" Tag="Desktop" Click="QuickTarget_Click" Style="{StaticResource SidebarTargetButton}">
            <StackPanel Orientation="Horizontal">
              <Path Data="M3,4 H21 V16 H3 Z M8,20 H16 M12,16 V20" Stroke="#0284C7" StrokeThickness="1.6" Width="15" Height="15" Stretch="Uniform" Margin="0,0,9,0"/>
              <TextBlock Text="Desktop" />
            </StackPanel>
          </Button>
          <Button x:Name="QuickDocumentsBtn" Tag="Documents" Click="QuickTarget_Click" Style="{StaticResource SidebarTargetButton}">
            <StackPanel Orientation="Horizontal">
              <Path Data="M6,2 H14 L19,7 V21 H6 Z M14,2 V7 H19" Stroke="#0284C7" StrokeThickness="1.6" Width="15" Height="15" Stretch="Uniform" Margin="0,0,9,0"/>
              <TextBlock Text="Documents" />
            </StackPanel>
          </Button>
          <Button x:Name="QuickVideosBtn" Tag="Videos" Click="QuickTarget_Click" Style="{StaticResource SidebarTargetButton}">
            <StackPanel Orientation="Horizontal">
              <Path Data="M3,6 H16 V18 H3 Z M16,10 L21,7 V17 L16,14 Z" Stroke="#0284C7" StrokeThickness="1.6" Width="15" Height="15" Stretch="Uniform" Margin="0,0,9,0"/>
              <TextBlock Text="Videos" />
            </StackPanel>
          </Button>
        </StackPanel>

        <!-- Tucked Scan Options -->
        <Border Grid.Row="2" BorderBrush="{StaticResource SkyHairline}" BorderThickness="0,1,0,0" Padding="4,14,4,0">
          <StackPanel>
            <TextBlock Text="SCAN OPTIONS" FontSize="10.5" FontWeight="SemiBold" Foreground="#64748B" Margin="2,0,0,10" />
            <CheckBox x:Name="IncludeCachesCheck" Content="Include hidden (.*)" FontSize="12" Foreground="#334155" Margin="0,0,0,8"
                      ToolTip="Include hidden dot-folders (.cache, .android, .docker, .gradle, venv). OS, AppData, .git, and node_modules remain excluded." />
            <CheckBox x:Name="FastSampleCheck" Content="Fast hash (&gt; 16 MB)" IsChecked="True" FontSize="12" Foreground="#334155" Margin="0,0,0,10"
                      ToolTip="Uses 8 distributed 64 KB blocks on files over 16 MB for sub-10s scans." />
            <TextBlock Text="Min duplicate size" FontSize="11.5" Foreground="#64748B" Margin="2,0,0,4"/>
            <ComboBox x:Name="MinDupSizeCombo" SelectedIndex="0" FontSize="12">
              <ComboBoxItem Content="100 KB+ (Fast)" Tag="102400"/>
              <ComboBoxItem Content="10 KB+" Tag="10240"/>
              <ComboBoxItem Content="1 MB+" Tag="1048576"/>
              <ComboBoxItem Content="All (&gt; 0 B)" Tag="1"/>
            </ComboBox>

            <!-- 1-Click MCP Agent Integration Button -->
            <Button x:Name="CopyMcpConfigBtn" Content="⚡ Connect AI / MCP" Click="CopyMcpConfig_Click"
                    Style="{StaticResource SecondaryButton}" Height="34" Margin="0,14,0,0" HorizontalAlignment="Stretch"
                    ToolTip="Copies ready-to-paste MCP config for Claude Code, Cursor, and Claude Desktop to your clipboard."/>
          </StackPanel>
        </Border>
      </Grid>
    </Border>

    <!-- =================================================================== -->
    <!-- 2. CENTER WORKSPACE (Clean Top Scan Bar + Underline Tabs + Bento)   -->
    <!-- =================================================================== -->
    <Grid Grid.Column="1">
      <Grid.Background>
        <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
          <GradientStop Color="#F6FAFF" Offset="0"/>
          <GradientStop Color="#FFFFFF" Offset="0.35"/>
        </LinearGradientBrush>
      </Grid.Background>
      <Grid.RowDefinitions>
        <RowDefinition Height="Auto"/>
        <RowDefinition Height="*"/>
        <RowDefinition Height="Auto"/>
      </Grid.RowDefinitions>

      <!-- Clean Single-Line Top Scan Bar (No squeezed right pill, no shifting progress row) -->
      <Grid Grid.Row="0" Margin="24,18,24,10">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*"/>
          <ColumnDefinition Width="Auto"/>
          <ColumnDefinition Width="Auto"/>
        </Grid.ColumnDefinitions>

        <TextBox x:Name="RootsBox" Grid.Column="0" MinHeight="40" MaxHeight="68" AcceptsReturn="True"
                 Padding="12,9" VerticalContentAlignment="Center" VerticalScrollBarVisibility="Auto"
                 BorderBrush="#CFE3FA" BorderThickness="1" Background="White"
                 FontFamily="{StaticResource MonoFont}" FontSize="12.5" Foreground="#0F172A" />

        <Button x:Name="AddFolderButton" Grid.Column="1" Content="+ Add" Click="Browse_Click" Style="{StaticResource SecondaryButton}" Height="40" Margin="10,0,8,0"/>
        <Button x:Name="ScanButton" Grid.Column="2" Content="Scan" Click="Scan_Click" Height="40" MinWidth="92"/>
        <Button x:Name="CancelButton" Grid.Column="2" Content="Cancel" Click="Cancel_Click" Style="{StaticResource SecondaryButton}" Height="40" MinWidth="92" Visibility="Collapsed"/>
      </Grid>

      <!-- Underline Navigation Tabs + Inline Right Controls -->
      <Grid Grid.Row="1" Margin="24,0,24,0">
        <TabControl x:Name="ResultsTabs" Style="{StaticResource UnderlineTabControl}" SelectionChanged="ResultsTabs_SelectionChanged">

          <!-- CONCEPT 4: BENTO OVERVIEW WITH CARD ICONS, LARGER DONUT & SPINNERS -->
          <TabItem Header="Overview">
            <Grid Margin="0,20,0,22">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="1.15*"/>
                <ColumnDefinition Width="16"/>
                <ColumnDefinition Width="1.35*"/>
              </Grid.ColumnDefinitions>

              <!-- Left Hero Bento Tile -->
              <Border Grid.Column="0" BorderBrush="#BAE6FD" BorderThickness="1" CornerRadius="14" Padding="24" Effect="{StaticResource SoftSkyShadow}">
                <Border.Background>
                  <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                    <GradientStop Color="#E6F4FE" Offset="0"/>
                    <GradientStop Color="#F6FAFF" Offset="1"/>
                  </LinearGradientBrush>
                </Border.Background>
                <Grid>
                  <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                  </Grid.RowDefinitions>

                  <!-- Hero Header -->
                  <StackPanel Grid.Row="0" Margin="0,0,0,6">
                    <TextBlock Text="Reclaimable Space" FontFamily="{StaticResource DisplayFont}" FontSize="14" FontWeight="SemiBold" Foreground="#0369A1"/>
                    <TextBlock x:Name="ScanTimingText" Text="" FontFamily="{StaticResource MonoFont}" FontSize="11.5" Foreground="#0284C7" Margin="0,3,0,0" Visibility="Collapsed"/>
                  </StackPanel>

                  <!-- Idle / Result View -->
                  <Grid Grid.Row="1" x:Name="HeroResultPanel">
                    <Grid.RowDefinitions>
                      <RowDefinition Height="Auto"/>
                      <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0" x:Name="ReclaimableSpaceText" Text="—" FontFamily="{StaticResource DisplayFont}" FontSize="40" FontWeight="Bold"
                               Foreground="#0F172A" Typography.NumeralAlignment="Tabular" Margin="0,0,0,10"/>

                    <!-- Enlarged Donut Ring + Larger Legend -->
                    <StackPanel Grid.Row="1" VerticalAlignment="Center" HorizontalAlignment="Center" Margin="0,2,0,12">
                      <Grid Width="200" Height="200" HorizontalAlignment="Center">
                        <Canvas x:Name="DonutCanvas" Width="200" Height="200"/>
                        <TextBlock x:Name="DonutCenterText" Text="—" FontFamily="{StaticResource DisplayFont}" FontSize="24" FontWeight="Bold"
                                   Foreground="#0369A1" HorizontalAlignment="Center" VerticalAlignment="Center" Typography.NumeralAlignment="Tabular"/>
                      </Grid>
                      <WrapPanel HorizontalAlignment="Center" Margin="0,16,0,0">
                        <StackPanel Orientation="Horizontal" Margin="0,0,14,6">
                          <Ellipse Width="9" Height="9" Fill="#0284C7" Margin="0,0,6,0" VerticalAlignment="Center"/>
                          <TextBlock x:Name="LegendDupText" Text="Duplicates" FontSize="13" FontWeight="Medium" Foreground="#334155"/>
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,0,14,6">
                          <Ellipse Width="9" Height="9" Fill="#38BDF8" Margin="0,0,6,0" VerticalAlignment="Center"/>
                          <TextBlock x:Name="LegendLargeText" Text="Large" FontSize="13" FontWeight="Medium" Foreground="#334155"/>
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                          <Ellipse Width="9" Height="9" Fill="#BAE6FD" Margin="0,0,6,0" VerticalAlignment="Center"/>
                          <TextBlock x:Name="LegendForgottenText" Text="Forgotten" FontSize="13" FontWeight="Medium" Foreground="#334155"/>
                        </StackPanel>
                      </WrapPanel>
                    </StackPanel>
                  </Grid>

                  <!-- Live Scanning View Inside Hero Card -->
                  <StackPanel Grid.Row="1" x:Name="HeroLoadingPanel" VerticalAlignment="Center" HorizontalAlignment="Center" Margin="12,0" Visibility="Collapsed">
                    <Control Style="{StaticResource LoadingSpinner}" Width="54" Height="54" Margin="0,0,0,18"/>
                    <TextBlock x:Name="ScanStageText" Text="Discovering files…" FontFamily="{StaticResource DisplayFont}" FontSize="17" FontWeight="SemiBold"
                               Foreground="#0F172A" HorizontalAlignment="Center" Margin="0,0,0,6"/>
                    <TextBlock x:Name="ScanProgressCountText" Text="0 files · 0 B" FontFamily="{StaticResource MonoFont}" FontSize="13.5" FontWeight="SemiBold"
                               Foreground="#0284C7" HorizontalAlignment="Center" Margin="0,0,0,12"/>
                    <TextBlock x:Name="ScanCurrentPathText" Text="" FontFamily="{StaticResource MonoFont}" FontSize="11.5"
                               Foreground="#64748B" TextAlignment="Center" TextWrapping="Wrap" MaxHeight="38" MaxWidth="340" TextTrimming="CharacterEllipsis"/>
                  </StackPanel>

                  <Button Grid.Row="2" x:Name="SmartCleanBtn" Content="⚡ 1-Click Clean Safe Junk" Click="SmartClean_Click" Height="40" HorizontalAlignment="Stretch"
                          ToolTip="Safely moves redundant duplicate copies, old installers in Downloads, and crash dumps to the Windows Recycle Bin."/>
                </Grid>
              </Border>

              <!-- Right 2x2 Bento Grid (Icons + Spinners on Every Card) -->
              <Grid Grid.Column="2">
                <Grid.RowDefinitions>
                  <RowDefinition Height="*"/>
                  <RowDefinition Height="14"/>
                  <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="*"/>
                  <ColumnDefinition Width="14"/>
                  <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- Card 1: Files Scanned -->
                <Border Grid.Row="0" Grid.Column="0" Background="White" BorderBrush="{StaticResource SkyHairline}" BorderThickness="1" CornerRadius="12" Padding="22,20">
                  <Grid>
                    <Grid.RowDefinitions>
                      <RowDefinition Height="Auto"/>
                      <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <TextBlock Grid.Row="0" Text="Files Scanned" FontSize="13" FontWeight="Medium" Foreground="#64748B"/>
                    <Grid Grid.Row="1" VerticalAlignment="Center">
                      <TextBlock x:Name="FilesCount" Text="—" FontFamily="{StaticResource DisplayFont}" FontSize="32" FontWeight="Bold"
                                 Foreground="#0F172A" Typography.NumeralAlignment="Tabular"/>
                      <Control x:Name="FilesSpinner" Style="{StaticResource LoadingSpinner}" Width="28" Height="28" HorizontalAlignment="Left" Visibility="Collapsed"/>
                    </Grid>
                  </Grid>
                </Border>

                <!-- Card 2: Total Storage -->
                <Border Grid.Row="0" Grid.Column="2" Background="White" BorderBrush="{StaticResource SkyHairline}" BorderThickness="1" CornerRadius="12" Padding="22,20">
                  <Grid>
                    <Grid.RowDefinitions>
                      <RowDefinition Height="Auto"/>
                      <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <TextBlock Grid.Row="0" Text="Total Storage" FontSize="13" FontWeight="Medium" Foreground="#64748B"/>
                    <Grid Grid.Row="1" VerticalAlignment="Center">
                      <TextBlock x:Name="TotalScannedSize" Text="—" FontFamily="{StaticResource DisplayFont}" FontSize="32" FontWeight="Bold"
                                 Foreground="#0F172A" Typography.NumeralAlignment="Tabular"/>
                      <Control x:Name="StorageSpinner" Style="{StaticResource LoadingSpinner}" Width="28" Height="28" HorizontalAlignment="Left" Visibility="Collapsed"/>
                    </Grid>
                  </Grid>
                </Border>

                <!-- Card 3: Forgotten Files -->
                <Button Grid.Row="2" Grid.Column="0" Style="{StaticResource BentoTileButton}" Click="JumpForgotten_Click">
                  <Grid>
                    <Grid.RowDefinitions>
                      <RowDefinition Height="Auto"/>
                      <RowDefinition Height="*"/>
                      <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <TextBlock Grid.Row="0" Text="Forgotten Files" FontSize="13" FontWeight="Medium" Foreground="#64748B"/>
                    <Grid Grid.Row="1" VerticalAlignment="Center">
                      <TextBlock x:Name="ForgottenCount" Text="—" FontFamily="{StaticResource DisplayFont}" FontSize="30" FontWeight="Bold"
                                 Foreground="#0F172A" Typography.NumeralAlignment="Tabular"/>
                      <Control x:Name="ForgottenSpinner" Style="{StaticResource LoadingSpinner}" Width="28" Height="28" HorizontalAlignment="Left" Visibility="Collapsed"/>
                    </Grid>
                    <TextBlock Grid.Row="2" Text="30d+ untouched &gt;" FontSize="12.5" FontWeight="SemiBold" Foreground="{StaticResource SkyPrimary}"/>
                  </Grid>
                </Button>

                <!-- Card 4: Large Files -->
                <Button Grid.Row="2" Grid.Column="2" Style="{StaticResource BentoTileButton}" Click="JumpLarge_Click">
                  <Grid>
                    <Grid.RowDefinitions>
                      <RowDefinition Height="Auto"/>
                      <RowDefinition Height="*"/>
                      <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <TextBlock Grid.Row="0" Text="Large Files" FontSize="13" FontWeight="Medium" Foreground="#64748B"/>
                    <Grid Grid.Row="1" VerticalAlignment="Center">
                      <TextBlock x:Name="LargeCount" Text="—" FontFamily="{StaticResource DisplayFont}" FontSize="30" FontWeight="Bold"
                                 Foreground="#0F172A" Typography.NumeralAlignment="Tabular"/>
                      <Control x:Name="LargeSpinner" Style="{StaticResource LoadingSpinner}" Width="28" Height="28" HorizontalAlignment="Left" Visibility="Collapsed"/>
                    </Grid>
                    <TextBlock Grid.Row="2" Text="100 MB+ &gt;" FontSize="12.5" FontWeight="SemiBold" Foreground="{StaticResource SkyPrimary}"/>
                  </Grid>
                </Button>
              </Grid>
            </Grid>
          </TabItem>

          <!-- AIRY LEDGER — FORGOTTEN -->
          <TabItem x:Name="ForgottenTab" Header="Forgotten">
            <Grid>
              <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
              </Grid.RowDefinitions>
              <Grid Grid.Row="0" Margin="0,10,0,6">
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="*"/>
                  <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                  <ComboBox x:Name="AgeFilter" MinWidth="112" SelectedIndex="2" SelectionChanged="Filters_SelectionChanged">
                    <ComboBoxItem Content="7 days+" Tag="7"/>
                    <ComboBoxItem Content="15 days+" Tag="15"/>
                    <ComboBoxItem Content="30 days+" Tag="30"/>
                    <ComboBoxItem Content="60 days+" Tag="60"/>
                    <ComboBoxItem Content="90 days+" Tag="90"/>
                  </ComboBox>
                </StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal">
                  <Button x:Name="ForgottenToggleSelectBtn" Content="Select all" Click="ForgottenToggleSelect_Click" Style="{StaticResource SecondaryButton}" />
                </StackPanel>
              </Grid>

              <DataGrid x:Name="ForgottenGrid" Grid.Row="1" AutoGenerateColumns="False" CanUserAddRows="False" IsReadOnly="False"
                        SelectionMode="Extended" SelectionChanged="Grid_SelectionChanged" HeadersVisibility="Column" GridLinesVisibility="Horizontal"
                        VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling"
                        EnableRowVirtualization="True" ScrollViewer.CanContentScroll="True">
                <DataGrid.Columns>
                  <DataGridTemplateColumn Width="48" CanUserResize="False">
                    <DataGridTemplateColumn.HeaderStyle>
                      <Style TargetType="DataGridColumnHeader" BasedOn="{StaticResource {x:Type DataGridColumnHeader}}">
                        <Setter Property="HorizontalContentAlignment" Value="Center"/>
                        <Setter Property="Padding" Value="0"/>
                      </Style>
                    </DataGridTemplateColumn.HeaderStyle>
                    <DataGridTemplateColumn.CellStyle>
                      <Style TargetType="DataGridCell" BasedOn="{StaticResource {x:Type DataGridCell}}">
                        <Setter Property="Padding" Value="0"/>
                        <Setter Property="HorizontalContentAlignment" Value="Center"/>
                      </Style>
                    </DataGridTemplateColumn.CellStyle>
                    <DataGridTemplateColumn.CellTemplate>
                      <DataTemplate>
                        <CheckBox IsChecked="{Binding Selected, UpdateSourceTrigger=PropertyChanged}"
                                  HorizontalAlignment="Center" VerticalAlignment="Center" Focusable="False"/>
                      </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                  </DataGridTemplateColumn>

                  <DataGridTemplateColumn Header="Type" Width="82" IsReadOnly="True">
                    <DataGridTemplateColumn.CellTemplate>
                      <DataTemplate>
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                          <Image Source="{Binding IconImage}" Width="16" Height="16" Margin="0,0,6,0" VerticalAlignment="Center" RenderOptions.BitmapScalingMode="HighQuality"/>
                          <TextBlock Text="{Binding ExtensionText}" FontSize="11" FontWeight="Normal" Foreground="{Binding TypeBadgeFg}"
                                     FontFamily="{StaticResource MonoFont}" VerticalAlignment="Center"/>
                        </StackPanel>
                      </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                  </DataGridTemplateColumn>

                  <DataGridTextColumn Header="Name" Binding="{Binding Name}" ElementStyle="{StaticResource FileNameCellText}" Width="210" IsReadOnly="True"/>
                  <DataGridTextColumn Header="Size" Binding="{Binding SizeText}" ElementStyle="{StaticResource MonoCellText}" Width="90" IsReadOnly="True"/>
                  <DataGridTextColumn Header="Last accessed" Binding="{Binding AccessedText}" ElementStyle="{StaticResource MonoCellText}" Width="140" IsReadOnly="True"/>
                  <DataGridTextColumn Header="Modified" Binding="{Binding ModifiedText}" ElementStyle="{StaticResource MonoCellText}" Width="140" IsReadOnly="True"/>
                  <DataGridTextColumn Header="Path" Binding="{Binding Path}" ElementStyle="{StaticResource MonoCellText}" Width="*" IsReadOnly="True"/>
                </DataGrid.Columns>
              </DataGrid>
            </Grid>
          </TabItem>

          <!-- AIRY LEDGER — DUPLICATES -->
          <TabItem x:Name="DuplicatesTab" Header="Duplicates">
            <Grid>
              <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
              </Grid.RowDefinitions>
              <Grid Grid.Row="0" Margin="0,10,0,6">
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="*"/>
                  <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                  <Button Content="Keep newest" Click="KeepNewest_Click" Style="{StaticResource SecondaryButton}" Margin="0,0,6,0" />
                  <Button Content="Keep oldest" Click="KeepOldest_Click" Style="{StaticResource SecondaryButton}" />
                </StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal">
                  <Button x:Name="DuplicatesToggleSelectBtn" Content="Select all" Click="DuplicatesToggleSelect_Click" Style="{StaticResource SecondaryButton}" />
                </StackPanel>
              </Grid>

              <DataGrid x:Name="DuplicatesGrid" Grid.Row="1" AutoGenerateColumns="False" CanUserAddRows="False" IsReadOnly="False"
                        SelectionMode="Extended" SelectionChanged="Grid_SelectionChanged" HeadersVisibility="Column" GridLinesVisibility="Horizontal"
                        VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling"
                        EnableRowVirtualization="True" ScrollViewer.CanContentScroll="True">
                <DataGrid.Columns>
                  <DataGridTemplateColumn Width="48" CanUserResize="False">
                    <DataGridTemplateColumn.HeaderStyle>
                      <Style TargetType="DataGridColumnHeader" BasedOn="{StaticResource {x:Type DataGridColumnHeader}}">
                        <Setter Property="HorizontalContentAlignment" Value="Center"/>
                        <Setter Property="Padding" Value="0"/>
                      </Style>
                    </DataGridTemplateColumn.HeaderStyle>
                    <DataGridTemplateColumn.CellStyle>
                      <Style TargetType="DataGridCell" BasedOn="{StaticResource {x:Type DataGridCell}}">
                        <Setter Property="Padding" Value="0"/>
                        <Setter Property="HorizontalContentAlignment" Value="Center"/>
                      </Style>
                    </DataGridTemplateColumn.CellStyle>
                    <DataGridTemplateColumn.CellTemplate>
                      <DataTemplate>
                        <CheckBox IsChecked="{Binding Selected, UpdateSourceTrigger=PropertyChanged}"
                                  HorizontalAlignment="Center" VerticalAlignment="Center" Focusable="False"/>
                      </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                  </DataGridTemplateColumn>

                  <DataGridTemplateColumn Header="Type" Width="82" IsReadOnly="True">
                    <DataGridTemplateColumn.CellTemplate>
                      <DataTemplate>
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                          <Image Source="{Binding IconImage}" Width="16" Height="16" Margin="0,0,6,0" VerticalAlignment="Center" RenderOptions.BitmapScalingMode="HighQuality"/>
                          <TextBlock Text="{Binding ExtensionText}" FontSize="11" FontWeight="Normal" Foreground="{Binding TypeBadgeFg}"
                                     FontFamily="{StaticResource MonoFont}" VerticalAlignment="Center"/>
                        </StackPanel>
                      </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                  </DataGridTemplateColumn>

                  <DataGridTextColumn Header="Group" Binding="{Binding DuplicateGroupId}" ElementStyle="{StaticResource MonoCellText}" Width="65" IsReadOnly="True"/>
                  <DataGridTextColumn Header="Name" Binding="{Binding Name}" ElementStyle="{StaticResource FileNameCellText}" Width="210" IsReadOnly="True"/>
                  <DataGridTextColumn Header="Size" Binding="{Binding SizeText}" ElementStyle="{StaticResource MonoCellText}" Width="90" IsReadOnly="True"/>
                  <DataGridTextColumn Header="Copies" Binding="{Binding DuplicateGroupCount}" ElementStyle="{StaticResource MonoCellText}" Width="65" IsReadOnly="True"/>
                  <DataGridTextColumn Header="Modified" Binding="{Binding ModifiedText}" ElementStyle="{StaticResource MonoCellText}" Width="140" IsReadOnly="True"/>
                  <DataGridTextColumn Header="Path" Binding="{Binding Path}" ElementStyle="{StaticResource MonoCellText}" Width="*" IsReadOnly="True"/>
                </DataGrid.Columns>
              </DataGrid>
            </Grid>
          </TabItem>

          <!-- AIRY LEDGER — LARGE -->
          <TabItem x:Name="LargeTab" Header="Large">
            <Grid>
              <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
              </Grid.RowDefinitions>
              <Grid Grid.Row="0" Margin="0,10,0,6">
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="*"/>
                  <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                  <ComboBox x:Name="SizeFilter" MinWidth="112" SelectedIndex="0" SelectionChanged="Filters_SelectionChanged">
                    <ComboBoxItem Content="100 MB+" Tag="104857600"/>
                    <ComboBoxItem Content="500 MB+" Tag="524288000"/>
                    <ComboBoxItem Content="1 GB+" Tag="1073741824"/>
                    <ComboBoxItem Content="5 GB+" Tag="5368709120"/>
                  </ComboBox>
                </StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal">
                  <Button x:Name="LargeToggleSelectBtn" Content="Select all" Click="LargeToggleSelect_Click" Style="{StaticResource SecondaryButton}" />
                </StackPanel>
              </Grid>

              <DataGrid x:Name="LargeGrid" Grid.Row="1" AutoGenerateColumns="False" CanUserAddRows="False" IsReadOnly="False"
                        SelectionMode="Extended" SelectionChanged="Grid_SelectionChanged" HeadersVisibility="Column" GridLinesVisibility="Horizontal"
                        VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling"
                        EnableRowVirtualization="True" ScrollViewer.CanContentScroll="True">
                <DataGrid.Columns>
                  <DataGridTemplateColumn Width="48" CanUserResize="False">
                    <DataGridTemplateColumn.HeaderStyle>
                      <Style TargetType="DataGridColumnHeader" BasedOn="{StaticResource {x:Type DataGridColumnHeader}}">
                        <Setter Property="HorizontalContentAlignment" Value="Center"/>
                        <Setter Property="Padding" Value="0"/>
                      </Style>
                    </DataGridTemplateColumn.HeaderStyle>
                    <DataGridTemplateColumn.CellStyle>
                      <Style TargetType="DataGridCell" BasedOn="{StaticResource {x:Type DataGridCell}}">
                        <Setter Property="Padding" Value="0"/>
                        <Setter Property="HorizontalContentAlignment" Value="Center"/>
                      </Style>
                    </DataGridTemplateColumn.CellStyle>
                    <DataGridTemplateColumn.CellTemplate>
                      <DataTemplate>
                        <CheckBox IsChecked="{Binding Selected, UpdateSourceTrigger=PropertyChanged}"
                                  HorizontalAlignment="Center" VerticalAlignment="Center" Focusable="False"/>
                      </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                  </DataGridTemplateColumn>

                  <DataGridTemplateColumn Header="Type" Width="82" IsReadOnly="True">
                    <DataGridTemplateColumn.CellTemplate>
                      <DataTemplate>
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                          <Image Source="{Binding IconImage}" Width="16" Height="16" Margin="0,0,6,0" VerticalAlignment="Center" RenderOptions.BitmapScalingMode="HighQuality"/>
                          <TextBlock Text="{Binding ExtensionText}" FontSize="11" FontWeight="Normal" Foreground="{Binding TypeBadgeFg}"
                                     FontFamily="{StaticResource MonoFont}" VerticalAlignment="Center"/>
                        </StackPanel>
                      </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                  </DataGridTemplateColumn>

                  <DataGridTextColumn Header="Name" Binding="{Binding Name}" ElementStyle="{StaticResource FileNameCellText}" Width="210" IsReadOnly="True"/>
                  <DataGridTextColumn Header="Size" Binding="{Binding SizeText}" ElementStyle="{StaticResource MonoCellText}" Width="90" IsReadOnly="True"/>
                  <DataGridTextColumn Header="Modified" Binding="{Binding ModifiedText}" ElementStyle="{StaticResource MonoCellText}" Width="140" IsReadOnly="True"/>
                  <DataGridTextColumn Header="Path" Binding="{Binding Path}" ElementStyle="{StaticResource MonoCellText}" Width="*" IsReadOnly="True"/>
                </DataGrid.Columns>
              </DataGrid>
            </Grid>
          </TabItem>

          <!-- AIRY LEDGER — DEV CACHES & ARTIFACTS HUNTER -->
          <TabItem x:Name="DevCachesTab" Header="Dev Caches">
            <Grid>
              <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
              </Grid.RowDefinitions>
              <Grid Grid.Row="0" Margin="0,10,0,6">
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="*"/>
                  <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" Text="Dormant project packages &amp; build artifacts (node_modules, venvs, target, bin/obj)"
                           FontSize="12" Foreground="#64748B" VerticalAlignment="Center"/>
                <StackPanel Grid.Column="1" Orientation="Horizontal">
                  <Button x:Name="DevToggleSelectBtn" Content="Select all" Click="DevToggleSelect_Click" Style="{StaticResource SecondaryButton}" Margin="0,0,8,0"/>
                  <Button x:Name="CleanDevCachesBtn" Content="Clean Selected Caches" Click="CleanDevCaches_Click" Style="{StaticResource DangerButton}"/>
                </StackPanel>
              </Grid>

              <DataGrid x:Name="DevCachesGrid" Grid.Row="1" AutoGenerateColumns="False" CanUserAddRows="False" IsReadOnly="False"
                        SelectionMode="Extended" HeadersVisibility="Column" GridLinesVisibility="Horizontal"
                        VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling"
                        EnableRowVirtualization="True" ScrollViewer.CanContentScroll="True">
                <DataGrid.Columns>
                  <DataGridTemplateColumn Width="48" CanUserResize="False">
                    <DataGridTemplateColumn.HeaderStyle>
                      <Style TargetType="DataGridColumnHeader" BasedOn="{StaticResource {x:Type DataGridColumnHeader}}">
                        <Setter Property="HorizontalContentAlignment" Value="Center"/>
                        <Setter Property="Padding" Value="0"/>
                      </Style>
                    </DataGridTemplateColumn.HeaderStyle>
                    <DataGridTemplateColumn.CellStyle>
                      <Style TargetType="DataGridCell" BasedOn="{StaticResource {x:Type DataGridCell}}">
                        <Setter Property="Padding" Value="0"/>
                        <Setter Property="HorizontalContentAlignment" Value="Center"/>
                      </Style>
                    </DataGridTemplateColumn.CellStyle>
                    <DataGridTemplateColumn.CellTemplate>
                      <DataTemplate>
                        <CheckBox IsChecked="{Binding Selected, UpdateSourceTrigger=PropertyChanged}"
                                  HorizontalAlignment="Center" VerticalAlignment="Center" Focusable="False"/>
                      </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                  </DataGridTemplateColumn>

                  <DataGridTemplateColumn Header="Type" Width="120" IsReadOnly="True">
                    <DataGridTemplateColumn.CellTemplate>
                      <DataTemplate>
                        <Border Background="{Binding TypeBadgeBg}" BorderBrush="{Binding TypeBadgeBorder}" BorderThickness="1"
                                CornerRadius="4" Padding="6,2" HorizontalAlignment="Left" VerticalAlignment="Center">
                          <TextBlock Text="{Binding CacheType}" FontSize="10.5" FontWeight="Medium" Foreground="{Binding TypeBadgeFg}"
                                     FontFamily="{StaticResource MonoFont}"/>
                        </Border>
                      </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                  </DataGridTemplateColumn>

                  <DataGridTextColumn Header="Project" Binding="{Binding ProjectName}" ElementStyle="{StaticResource FileNameCellText}" Width="190" IsReadOnly="True"/>
                  <DataGridTextColumn Header="Size" Binding="{Binding SizeText}" ElementStyle="{StaticResource MonoCellText}" Width="95" IsReadOnly="True"/>
                  <DataGridTextColumn Header="Last modified" Binding="{Binding ModifiedText}" ElementStyle="{StaticResource MonoCellText}" Width="140" IsReadOnly="True"/>
                  <DataGridTextColumn Header="Location" Binding="{Binding Path}" ElementStyle="{StaticResource MonoCellText}" Width="*" IsReadOnly="True"/>
                </DataGrid.Columns>
              </DataGrid>
            </Grid>
          </TabItem>
        </TabControl>

        <!-- Inline Right Extension Filter on Tab Strip -->
        <StackPanel x:Name="ExtFilterPanel" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,4,0,0" Visibility="Collapsed">
          <TextBlock Text="Ext:" Foreground="#64748B" FontSize="12" VerticalAlignment="Center" Margin="0,0,6,0"/>
          <TextBox x:Name="ExtensionFilter" Text="*" MinWidth="95" Padding="7,4" VerticalContentAlignment="Center"
                   BorderBrush="#CFE3FA" Background="White" FontFamily="{StaticResource MonoFont}" FontSize="12"
                   TextChanged="ExtensionFilter_TextChanged" ToolTip="Comma-separated extensions (e.g. .mp4,.zip) or * for all" />
        </StackPanel>
      </Grid>

      <!-- Quiet Bottom Hairline Action Bar (Hidden on Overview; No redundant duplicate buttons) -->
      <Border x:Name="ActionBar" Grid.Row="2" BorderBrush="{StaticResource SkyHairline}" BorderThickness="0,1,0,0" Padding="24,12" Visibility="Collapsed">
        <Grid>
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="Auto"/>
          </Grid.ColumnDefinitions>

          <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
            <TextBlock x:Name="SelectedSummaryText" Text="0 selected" FontFamily="{StaticResource MonoFont}" FontSize="12" FontWeight="Normal" Foreground="#1E293B" Margin="0,0,12,0"/>
            <TextBlock x:Name="ErrorSummary" Text="" FontFamily="{StaticResource MonoFont}" FontSize="11.5" Foreground="#B45309" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
          </StackPanel>

          <!-- Single clean bulk action button (Redundant 'Open in Explorer' removed!) -->
          <Button x:Name="DeleteButton" Grid.Column="1" Content="Move Selected to Recycle Bin" Click="Delete_Click" Style="{StaticResource DangerButton}" Height="34"/>
        </Grid>
      </Border>
    </Grid>

    <!-- =================================================================== -->
    <!-- 3. CONTEXTUAL RIGHT FILE INSPECTOR (On Row Click)                   -->
    <!-- =================================================================== -->
    <Border x:Name="InspectorPanel" Grid.Column="2" Width="290" Background="{StaticResource SkyInspectorBg}"
            BorderBrush="{StaticResource SkyHairline}" BorderThickness="1,0,0,0" Visibility="Collapsed">
      <Grid Margin="18,18,18,16">
        <Grid.RowDefinitions>
          <RowDefinition Height="Auto"/>
          <RowDefinition Height="*"/>
          <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Inspector Header -->
        <Grid Grid.Row="0" Margin="0,0,0,14">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="Auto"/>
          </Grid.ColumnDefinitions>
          <TextBlock Grid.Column="0" Text="FILE DETAILS" FontSize="10.5" FontWeight="SemiBold" Foreground="#64748B" VerticalAlignment="Center"/>
          <Button Grid.Column="1" Content="✕" Click="CloseInspector_Click" Style="{StaticResource SecondaryButton}" Padding="7,2" FontSize="11" ToolTip="Close inspector"/>
        </Grid>

        <!-- Inspector Scrollable Content -->
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
          <StackPanel>
            <!-- Primary File Identity Card (Top File Icon -> Name -> Details) -->
            <Border Background="White" BorderBrush="{StaticResource SkyHairline}" BorderThickness="1" CornerRadius="12" Padding="16,18" Margin="0,0,0,12">
              <StackPanel HorizontalAlignment="Center">
                <!-- Top File Type Icon Anchor (Clean, Borderless Vector SVG) -->
                <Image x:Name="InspectorFileIcon" Width="48" Height="48" HorizontalAlignment="Center" Margin="0,4,0,10"
                       RenderOptions.BitmapScalingMode="HighQuality"/>

                <!-- File Extension Pill -->
                <Border x:Name="InspectorExtBadge" Background="#EFF6FF" BorderBrush="#BAE6FD" BorderThickness="1" CornerRadius="4"
                        Padding="6,2" HorizontalAlignment="Center" Margin="0,0,0,10">
                  <TextBlock x:Name="InspectorExtText" Text="FILE" FontFamily="{StaticResource MonoFont}" FontSize="11" FontWeight="Medium" Foreground="#0284C7"/>
                </Border>

                <!-- File Name -->
                <TextBlock x:Name="InspectorFileName" Text="" FontFamily="{StaticResource DisplayFont}" FontSize="14" FontWeight="SemiBold"
                           Foreground="#0F172A" TextWrapping="Wrap" TextAlignment="Center" LineHeight="19" Margin="0,0,0,6"/>

                <!-- File Size -->
                <TextBlock x:Name="InspectorFileSize" Text="" FontFamily="{StaticResource MonoFont}" FontSize="12.5" FontWeight="Normal"
                           Foreground="#475569" TextAlignment="Center" Margin="0,0,12,0"/>

                <!-- File Path Box -->
                <Border Background="#F8FAFC" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="8" Padding="10,8" Margin="0,8,0,0" HorizontalAlignment="Stretch">
                  <TextBlock x:Name="InspectorFilePath" Text="" FontFamily="{StaticResource MonoFont}" FontSize="11" FontWeight="Normal"
                             Foreground="#475569" TextWrapping="Wrap" LineHeight="16"/>
                </Border>
              </StackPanel>
            </Border>

            <!-- Timestamps -->
            <Border Background="White" BorderBrush="{StaticResource SkyHairline}" BorderThickness="1" CornerRadius="12" Padding="14" Margin="0,0,0,12">
              <Grid>
                <Grid.RowDefinitions>
                  <RowDefinition Height="Auto"/>
                  <RowDefinition Height="8"/>
                  <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="76"/>
                  <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Row="0" Grid.Column="0" Text="Accessed" FontSize="11.5" FontWeight="Normal" Foreground="#64748B" VerticalAlignment="Center"/>
                <TextBlock Grid.Row="0" Grid.Column="1" x:Name="InspectorAccessed" Text="" FontFamily="{StaticResource MonoFont}" FontSize="11.5" FontWeight="Normal" Foreground="#1E293B" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                <TextBlock Grid.Row="2" Grid.Column="0" Text="Modified" FontSize="11.5" FontWeight="Normal" Foreground="#64748B" VerticalAlignment="Center"/>
                <TextBlock Grid.Row="2" Grid.Column="1" x:Name="InspectorModified" Text="" FontFamily="{StaticResource MonoFont}" FontSize="11.5" FontWeight="Normal" Foreground="#1E293B" HorizontalAlignment="Right" VerticalAlignment="Center"/>
              </Grid>
            </Border>

            <!-- Duplicate Sibling Copies -->
            <Border x:Name="InspectorDupSection" Background="#E6F4FE" BorderBrush="#BAE6FD" BorderThickness="1" CornerRadius="12" Padding="14" Visibility="Collapsed">
              <StackPanel>
                <TextBlock x:Name="InspectorDupSummary" Text="" FontSize="11.5" FontWeight="Medium" Foreground="#0369A1" TextWrapping="Wrap" Margin="0,0,0,8"/>
                <ItemsControl x:Name="InspectorSiblingsList">
                  <ItemsControl.ItemTemplate>
                    <DataTemplate>
                      <TextBlock Text="{Binding Path}" FontFamily="{StaticResource MonoFont}" FontSize="11" FontWeight="Normal" Foreground="#334155"
                                 TextWrapping="Wrap" Margin="0,0,0,6"/>
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>
              </StackPanel>
            </Border>
          </StackPanel>
        </ScrollViewer>

        <!-- Inspector Actions (Redundant 'Mark for Recycle' removed!) -->
        <StackPanel Grid.Row="2" Margin="0,12,0,0">
          <Button Content="Open in Explorer" Click="OpenLocation_Click" Style="{StaticResource SecondaryButton}" Height="34" Margin="0,0,0,8"/>
          <Button Content="Recycle This File" Click="InspectorDeleteSingle_Click" Style="{StaticResource DangerButton}" Height="34"/>
        </StackPanel>
      </Grid>
    </Border>
  </Grid>
</Window>
