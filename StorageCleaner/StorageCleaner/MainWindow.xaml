<Window x:Class="Vacumify.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Vacumify - Storage Cleaner" Height="780" Width="1200" MinHeight="620" MinWidth="920"
        Background="#F8FAFC" FontFamily="Segoe UI" Foreground="#1E293B">
  <Grid Margin="24">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="*"/>
      <RowDefinition Height="Auto"/>
    </Grid.RowDefinitions>

    <!-- Header -->
    <DockPanel Grid.Row="0" Margin="0,0,0,16">
      <StackPanel>
        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
          <TextBlock Text="Vacumify" FontSize="26" FontWeight="Bold" Foreground="#1E293B" />
          <Border Background="#DBEAFE" CornerRadius="4" Padding="6,2" Margin="10,0,0,0" VerticalAlignment="Center">
            <TextBlock Text="DESKTOP STORAGE CLEANER" FontSize="11" FontWeight="Bold" Foreground="#1D4ED8" />
          </Border>
        </StackPanel>
        <TextBlock Text="Local-first storage intelligence. Discover forgotten, duplicate, and large files. You choose what to remove." Foreground="#64748B" Margin="0,4,0,0" />
      </StackPanel>
      <Border DockPanel.Dock="Right" Background="#DCFCE7" CornerRadius="4" Padding="10,5" VerticalAlignment="Center">
        <TextBlock Text="100% LOCAL &amp; PRIVATE" FontSize="11" FontWeight="Bold" Foreground="#15803D" />
      </Border>
    </DockPanel>

    <!-- Scan Inputs -->
    <Border Grid.Row="1" Background="White" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="8" Padding="16" Margin="0,0,0,14">
      <Grid>
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*"/>
          <ColumnDefinition Width="Auto"/>
          <ColumnDefinition Width="Auto"/>
          <ColumnDefinition Width="Auto"/>
        </Grid.ColumnDefinitions>
        <StackPanel Grid.Column="0">
          <TextBlock Text="Folders or drives to scan (one per line)" FontWeight="SemiBold" Margin="0,0,0,6" />
          <TextBox x:Name="RootsBox" AcceptsReturn="True" Height="54" Padding="8" VerticalScrollBarVisibility="Auto" BorderBrush="#CBD5E1" />
        </StackPanel>
        <Button Grid.Column="1" Content="Add folder" Click="Browse_Click" Style="{StaticResource SecondaryButton}" VerticalAlignment="Bottom" Margin="10,0,8,0" Height="36"/>
        <Button x:Name="ScanButton" Grid.Column="2" Content="Start Scan" Click="Scan_Click" VerticalAlignment="Bottom" Height="36" Padding="18,8"/>
        <Button x:Name="CancelButton" Grid.Column="3" Content="Cancel" Click="Cancel_Click" VerticalAlignment="Bottom" IsEnabled="False" Style="{StaticResource SecondaryButton}" Height="36" Margin="0"/>
      </Grid>
    </Border>

    <!-- Progress & Filter Status -->
    <StackPanel Grid.Row="2" Margin="0,0,0,12">
      <ProgressBar x:Name="ScanProgress" Height="6" IsIndeterminate="True" Visibility="Collapsed" Margin="0,0,0,6" Foreground="#2563EB"/>
      <DockPanel>
        <TextBlock x:Name="StatusText" Text="Select folders or a drive, then start scanning." Foreground="#64748B" VerticalAlignment="Center" />
        <StackPanel Orientation="Horizontal" DockPanel.Dock="Right">
          <TextBlock Text="File types:" Foreground="#64748B" VerticalAlignment="Center" Margin="0,0,8,0"/>
          <TextBox x:Name="ExtensionFilter" Text="*" Width="160" Padding="5,3" BorderBrush="#CBD5E1" TextChanged="ExtensionFilter_TextChanged" ToolTip="Comma separated extensions (e.g. .mp4,.zip) or * for all"/>
        </StackPanel>
      </DockPanel>
    </StackPanel>

    <!-- Tabs Container -->
    <TabControl Grid.Row="3" x:Name="ResultsTabs" SelectionChanged="ResultsTabs_SelectionChanged" Background="White" BorderBrush="#E2E8F0">
      <!-- Overview Tab -->
      <TabItem Header="Overview">
        <Grid Margin="20">
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
          </Grid.RowDefinitions>
          
          <UniformGrid Columns="3" Margin="0,0,0,16">
            <Border Background="#F8FAFC" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="6" Padding="14" Margin="0,0,8,8">
              <StackPanel>
                <TextBlock Text="Files scanned" Foreground="#64748B" FontSize="13"/>
                <TextBlock x:Name="FilesCount" Text="—" FontSize="24" FontWeight="Bold" Foreground="#1E293B" Margin="0,4,0,0"/>
              </StackPanel>
            </Border>
            <Border Background="#F8FAFC" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="6" Padding="14" Margin="0,0,8,8">
              <StackPanel>
                <TextBlock Text="Total storage scanned" Foreground="#64748B" FontSize="13"/>
                <TextBlock x:Name="TotalScannedSize" Text="—" FontSize="24" FontWeight="Bold" Foreground="#1E293B" Margin="0,4,0,0"/>
              </StackPanel>
            </Border>
            <Border Background="#EFF6FF" BorderBrush="#BFDBFE" BorderThickness="1" CornerRadius="6" Padding="14" Margin="0,0,0,8">
              <StackPanel>
                <TextBlock Text="Reclaimable duplicate space" Foreground="#1D4ED8" FontSize="13" FontWeight="SemiBold"/>
                <TextBlock x:Name="ReclaimableSpaceText" Text="—" FontSize="24" FontWeight="Bold" Foreground="#1D4ED8" Margin="0,4,0,0"/>
              </StackPanel>
            </Border>
            <Border Background="#F8FAFC" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="6" Padding="14" Margin="0,0,8,0">
              <StackPanel>
                <TextBlock Text="Forgotten files" Foreground="#64748B" FontSize="13"/>
                <TextBlock x:Name="ForgottenCount" Text="—" FontSize="24" FontWeight="Bold" Foreground="#1E293B" Margin="0,4,0,0"/>
              </StackPanel>
            </Border>
            <Border Background="#F8FAFC" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="6" Padding="14" Margin="0,0,8,0">
              <StackPanel>
                <TextBlock Text="Duplicate copies" Foreground="#64748B" FontSize="13"/>
                <TextBlock x:Name="DuplicateCount" Text="—" FontSize="24" FontWeight="Bold" Foreground="#1E293B" Margin="0,4,0,0"/>
              </StackPanel>
            </Border>
            <Border Background="#F8FAFC" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="6" Padding="14">
              <StackPanel>
                <TextBlock Text="Large files" Foreground="#64748B" FontSize="13"/>
                <TextBlock x:Name="LargeCount" Text="—" FontSize="24" FontWeight="Bold" Foreground="#1E293B" Margin="0,4,0,0"/>
              </StackPanel>
            </Border>
          </UniformGrid>

          <Border Grid.Row="1" Background="#F8FAFC" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="8" Padding="24" VerticalAlignment="Center" HorizontalAlignment="Center" MaxWidth="720">
            <StackPanel HorizontalAlignment="Center">
              <TextBlock Text="Safe, Manual Storage Cleanup" FontSize="18" FontWeight="SemiBold" HorizontalAlignment="Center" />
              <TextBlock Text="Vacumify analyzes your storage but will never delete anything automatically." Foreground="#64748B" Margin="0,8,0,0" HorizontalAlignment="Center" />
              <TextBlock Text="• Review files across the tabs above (Forgotten, Duplicate, Large).&#x0a;• Use the checkboxes or smart selection tools to choose unwanted copies.&#x0a;• Confirmed files are safely moved to the Windows Recycle Bin." TextWrapping="Wrap" LineHeight="22" Foreground="#475569" Margin="0,16,0,0" />
              <TextBlock Text="Tip: Windows last-access timestamps are used as review hints. An older date does not guarantee a file is unused." TextWrapping="Wrap" FontSize="12" Foreground="#94A3B8" Margin="0,16,0,0" HorizontalAlignment="Center"/>
            </StackPanel>
          </Border>
        </Grid>
      </TabItem>

      <!-- Forgotten Files Tab -->
      <TabItem Header="Forgotten files">
        <Grid>
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
          </Grid.RowDefinitions>
          
          <DockPanel Margin="12,10">
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
              <TextBlock Text="Not accessed for" VerticalAlignment="Center" Margin="0,0,8,0"/>
              <ComboBox x:Name="AgeFilter" Width="130" SelectedIndex="2" SelectionChanged="Filters_SelectionChanged">
                <ComboBoxItem Content="7 days" Tag="7"/>
                <ComboBoxItem Content="15 days" Tag="15"/>
                <ComboBoxItem Content="30 days" Tag="30"/>
                <ComboBoxItem Content="60 days" Tag="60"/>
                <ComboBoxItem Content="90 days" Tag="90"/>
              </ComboBox>
            </StackPanel>
            <StackPanel Orientation="Horizontal" DockPanel.Dock="Right">
              <Button Content="Select all in view" Click="ForgottenSelectAll_Click" Style="{StaticResource SecondaryButton}" />
              <Button Content="Deselect all" Click="ForgottenDeselectAll_Click" Style="{StaticResource SecondaryButton}" Margin="0"/>
            </StackPanel>
          </DockPanel>

          <DataGrid x:Name="ForgottenGrid" Grid.Row="1" Margin="8" AutoGenerateColumns="False" CanUserAddRows="False" IsReadOnly="False" 
                    SelectionMode="Extended" HeadersVisibility="Column" GridLinesVisibility="Horizontal"
                    VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling" 
                    EnableRowVirtualization="True" ScrollViewer.CanContentScroll="True">
            <DataGrid.Columns>
              <DataGridCheckBoxColumn Header="Delete?" Binding="{Binding Selected, UpdateSourceTrigger=PropertyChanged}" Width="65"/>
              <DataGridTextColumn Header="Name" Binding="{Binding Name}" Width="200" IsReadOnly="True"/>
              <DataGridTextColumn Header="Size" Binding="{Binding SizeText}" Width="95" IsReadOnly="True"/>
              <DataGridTextColumn Header="Last accessed" Binding="{Binding AccessedText}" Width="140" IsReadOnly="True"/>
              <DataGridTextColumn Header="Last modified" Binding="{Binding ModifiedText}" Width="140" IsReadOnly="True"/>
              <DataGridTextColumn Header="Path" Binding="{Binding Path}" Width="*" IsReadOnly="True"/>
            </DataGrid.Columns>
          </DataGrid>
        </Grid>
      </TabItem>

      <!-- Duplicate Files Tab -->
      <TabItem Header="Duplicate files">
        <Grid>
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
          </Grid.RowDefinitions>

          <DockPanel Margin="12,10">
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
              <TextBlock Text="Smart selection:" FontWeight="SemiBold" VerticalAlignment="Center" Margin="0,0,10,0" Foreground="#475569"/>
              <Button Content="Keep newest in each group" Click="KeepNewest_Click" Style="{StaticResource SecondaryButton}" />
              <Button Content="Keep oldest in each group" Click="KeepOldest_Click" Style="{StaticResource SecondaryButton}" />
            </StackPanel>
            <StackPanel Orientation="Horizontal" DockPanel.Dock="Right">
              <Button Content="Select all duplicates" Click="DuplicatesSelectAll_Click" Style="{StaticResource SecondaryButton}" />
              <Button Content="Deselect all" Click="DuplicatesDeselectAll_Click" Style="{StaticResource SecondaryButton}" Margin="0"/>
            </StackPanel>
          </DockPanel>

          <DataGrid x:Name="DuplicatesGrid" Grid.Row="1" Margin="8" AutoGenerateColumns="False" CanUserAddRows="False" IsReadOnly="False" 
                    SelectionMode="Extended" HeadersVisibility="Column" GridLinesVisibility="Horizontal"
                    VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling" 
                    EnableRowVirtualization="True" ScrollViewer.CanContentScroll="True">
            <DataGrid.Columns>
              <DataGridCheckBoxColumn Header="Delete?" Binding="{Binding Selected, UpdateSourceTrigger=PropertyChanged}" Width="65"/>
              <DataGridTextColumn Header="Group #" Binding="{Binding DuplicateGroupId}" Width="75" IsReadOnly="True"/>
              <DataGridTextColumn Header="Name" Binding="{Binding Name}" Width="200" IsReadOnly="True"/>
              <DataGridTextColumn Header="Size" Binding="{Binding SizeText}" Width="95" IsReadOnly="True"/>
              <DataGridTextColumn Header="Copies" Binding="{Binding DuplicateGroupCount}" Width="75" IsReadOnly="True"/>
              <DataGridTextColumn Header="Last modified" Binding="{Binding ModifiedText}" Width="140" IsReadOnly="True"/>
              <DataGridTextColumn Header="Path" Binding="{Binding Path}" Width="*" IsReadOnly="True"/>
            </DataGrid.Columns>
          </DataGrid>
        </Grid>
      </TabItem>

      <!-- Large Files Tab -->
      <TabItem Header="Large files">
        <Grid>
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
          </Grid.RowDefinitions>

          <DockPanel Margin="12,10">
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
              <TextBlock Text="Size threshold:" VerticalAlignment="Center" Margin="0,0,8,0"/>
              <ComboBox x:Name="SizeFilter" Width="130" SelectedIndex="0" SelectionChanged="Filters_SelectionChanged">
                <ComboBoxItem Content="100 MB" Tag="104857600"/>
                <ComboBoxItem Content="500 MB" Tag="524288000"/>
                <ComboBoxItem Content="1 GB" Tag="1073741824"/>
                <ComboBoxItem Content="5 GB" Tag="5368709120"/>
              </ComboBox>
            </StackPanel>
            <StackPanel Orientation="Horizontal" DockPanel.Dock="Right">
              <Button Content="Select all in view" Click="LargeSelectAll_Click" Style="{StaticResource SecondaryButton}" />
              <Button Content="Deselect all" Click="LargeDeselectAll_Click" Style="{StaticResource SecondaryButton}" Margin="0"/>
            </StackPanel>
          </DockPanel>

          <DataGrid x:Name="LargeGrid" Grid.Row="1" Margin="8" AutoGenerateColumns="False" CanUserAddRows="False" IsReadOnly="False" 
                    SelectionMode="Extended" HeadersVisibility="Column" GridLinesVisibility="Horizontal"
                    VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling" 
                    EnableRowVirtualization="True" ScrollViewer.CanContentScroll="True">
            <DataGrid.Columns>
              <DataGridCheckBoxColumn Header="Delete?" Binding="{Binding Selected, UpdateSourceTrigger=PropertyChanged}" Width="65"/>
              <DataGridTextColumn Header="Name" Binding="{Binding Name}" Width="200" IsReadOnly="True"/>
              <DataGridTextColumn Header="Size" Binding="{Binding SizeText}" Width="95" IsReadOnly="True"/>
              <DataGridTextColumn Header="Last modified" Binding="{Binding ModifiedText}" Width="140" IsReadOnly="True"/>
              <DataGridTextColumn Header="Path" Binding="{Binding Path}" Width="*" IsReadOnly="True"/>
            </DataGrid.Columns>
          </DataGrid>
        </Grid>
      </TabItem>
    </TabControl>

    <!-- Bottom Actions Bar -->
    <DockPanel Grid.Row="4" Margin="0,14,0,0">
      <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
        <Border Background="#F1F5F9" CornerRadius="4" Padding="8,5" Margin="0,0,12,0">
          <TextBlock x:Name="SelectedSummaryText" Text="0 files selected (0 B)" FontWeight="SemiBold" Foreground="#1E293B"/>
        </Border>
        <TextBlock x:Name="ErrorSummary" Text="" Foreground="#D97706" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" MaxWidth="400"/>
      </StackPanel>
      
      <StackPanel Orientation="Horizontal" DockPanel.Dock="Right">
        <Button Content="Open location in Explorer" Click="OpenLocation_Click" Style="{StaticResource SecondaryButton}" Height="36"/>
        <Button x:Name="DeleteButton" Content="Move selected to Recycle Bin" Click="Delete_Click" Style="{StaticResource DangerButton}" Height="36" Margin="0"/>
      </StackPanel>
    </DockPanel>
  </Grid>
</Window>
