<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>Vacumify</AssemblyName>
    <RootNamespace>Vacumify</RootNamespace>
    <ApplicationIcon>Assets\vacumify.ico</ApplicationIcon>
  </PropertyGroup>
  <ItemGroup>
    <Resource Include="Assets\vacumify-logo.png" />
    <Resource Include="Assets\vacumify.ico" />
    <Resource Include="Assets\Fonts\*.ttf" />
  </ItemGroup>
</Project>
